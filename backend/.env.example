# ===== lark-plat backend .env.example =====
# Copy to .env and fill in real values. NEVER commit .env.

# App
APP_NAME=lark-plat
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# JWT (HS256)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Credential encryption (AES-GCM) - environment only, never in repo/image
CREDENTIAL_ENCRYPT_KEY=change-me-32-bytes-random-key

# Database (PostgreSQL) - POSTGRES_PASSWORD is required (compose fails fast if unset)
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_USER=lark
POSTGRES_DB=lark_plat
DATABASE_URL=postgresql+psycopg2://lark:lark@localhost:5432/lark_plat

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Concurrency guards (config_rule defaults)
EXEC_GLOBAL_CONCURRENCY=50
EXEC_HOST_CONCURRENCY=5
EXEC_BATCH_THRESHOLD=50

# CORS (frontend origin)
CORS_ORIGINS=["http://localhost:5173"]

# Audit / security
AUDIT_APPEND_ONLY=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10

# Bootstrap admin (seed) - REQUIRED in prod; dev/test fall back to documented default
SEED_ADMIN_PASSWORD=change-me-strong-admin-password
