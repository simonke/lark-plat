# lark-plat single-machine compose bootstrap (deploy/.env)
# Copy to deploy/.env:  cp deploy/.env.example deploy/.env
# Compose interpolation reads THIS file (deploy/.env), not backend/.env.
# Backend containers additionally load backend/.env (env_file) for app secrets.

POSTGRES_USER=lark
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lark_plat